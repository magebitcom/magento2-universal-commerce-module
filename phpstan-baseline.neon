parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between Magento\\Framework\\App\\Request\\Http and Magento\\Framework\\App\\Request\\Http will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: Controller/ApiController.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 3
			path: Model/CheckoutMeta/Model.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\CheckoutMeta\\Model\:\:getCheckoutId\(\) should return string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Model/CheckoutMeta/Model.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\CheckoutMeta\\Model\:\:getCreatedAt\(\) should return string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Model/CheckoutMeta/Model.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\CheckoutMeta\\Model\:\:getUpdatedAt\(\) should return string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Model/CheckoutMeta/Model.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\CheckoutMeta\\Model\:\:getWebhookUrl\(\) should return string\|null but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Model/CheckoutMeta/Model.php

		-
			message: '#^Cannot access offset ''webhook_url'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Constant Magebit\\UniversalCommerce\\Model\\Service\\Shopping\\AgentProfileParser\:\:CACHE_LIFETIME is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Constant Magebit\\UniversalCommerce\\Model\\Service\\Shopping\\AgentProfileParser\:\:CACHE_TAG is unused\.$#'
			identifier: classConstant.unused
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\Service\\Shopping\\AgentProfileParser\:\:fetchHttpProfile\(\) should return array\<string, mixed\>\|null but returns array\<mixed, mixed\>\|null\.$#'
			identifier: return.type
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\Service\\Shopping\\AgentProfileParser\:\:fetchValidated\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Method Magebit\\UniversalCommerce\\Model\\Service\\Shopping\\AgentProfileParser\:\:parseDataUri\(\) should return array\<string, mixed\>\|null but returns array\<mixed, mixed\>\|null\.$#'
			identifier: return.type
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Strict comparison using \!\=\= between string and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: Model/Service/Shopping/AgentProfileParser.php

		-
			message: '#^Call to function is_array\(\) with array\<string\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: Model/Service/Shopping/Converter/QuoteToFulfillmentResponse.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Model/Service/Shopping/Converter/QuoteToFulfillmentResponse.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: Model/Service/Shopping/Converter/QuoteToFulfillmentResponse.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: Model/Service/Shopping/Converter/QuoteToFulfillmentResponse.php

