<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="universal_commerce_idempotency_cleanup" instance="Magebit\UniversalCommerce\Model\IdempotencyKey\Cleanup" method="execute">
            <schedule>17 * * * *</schedule>
        </job>
        <job name="universal_commerce_dispatch_webhooks" instance="Magebit\UniversalCommerce\Cron\DispatchWebhooks" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
