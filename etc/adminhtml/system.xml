<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magebit" translate="label">
            <label>Magebit</label>
        </tab>
        <section id="universal_commerce" translate="label" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Universal Commerce Protocol</label>
            <tab>magebit</tab>
            <resource>Magebit_UniversalCommerce::config</resource>
            <group id="api" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>API Configuration</label>
                <field id="base_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Base URL</label>
                    <comment>Base URL for UCP API endpoints. If empty, the default store base URL will be used.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="require_request_id" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Require Request-Id Header</label>
                    <comment>The spec marks Request-Id as required. Disable only to accept clients that omit it.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="idempotency" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Idempotency</label>
                <field id="ttl_hours" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Stored Response TTL (hours)</label>
                    <comment>How long replayable responses are kept before the cleanup cron removes them. Set to 0 to disable cleanup.</comment>
                    <validate>validate-zero-or-greater validate-digits</validate>
                </field>
            </group>
            <group id="webhooks" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Order Event Webhooks</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Order Events</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Posts order lifecycle events to the URL the agent publishes in its own profile. Each delivery is signed with this store's key, which is published at /.well-known/ucp so the agent can verify it. The key is created automatically on first use.</comment>
                </field>
            </group>
            <group id="links" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Policy Links</label>
                <field id="privacy_policy" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Privacy Policy URL</label>
                    <comment>Absolute URL published as a `privacy_policy` link on every checkout response. Leave empty to omit.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="terms_of_service" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Terms of Service URL</label>
                    <comment>Absolute URL published as a `terms_of_service` link on every checkout response. Leave empty to omit.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="refund_policy" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Refund Policy URL</label>
                    <comment>Absolute URL published as a `refund_policy` link on every checkout response. Leave empty to omit.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="shipping_policy" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Shipping Policy URL</label>
                    <comment>Absolute URL published as a `shipping_policy` link on every checkout response. Leave empty to omit.</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="faq" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>FAQ URL</label>
                    <comment>Absolute URL published as a `faq` link on every checkout response. Leave empty to omit.</comment>
                    <validate>validate-url</validate>
                </field>
            </group>
        </section>
    </system>
</config>
