<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Checkout Meta -->
    <preference for="Magebit\UniversalCommerce\Api\Data\CheckoutMetaInterface" type="Magebit\UniversalCommerce\Model\CheckoutMeta\Model" />
    <preference for="Magebit\UniversalCommerce\Api\CheckoutMetaRepositoryInterface" type="Magebit\UniversalCommerce\Model\CheckoutMeta\Repository" />

    <!-- Service registry -->
    <type name="Magebit\UniversalCommerce\Model\Discovery\ServiceRegistry">
        <arguments>
            <argument name="services" xsi:type="array">
                <item name="dev.ucp.shopping" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\ShoppingService</item>
            </argument>
        </arguments>
    </type>

    <!-- Shopping service -->
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\RestHandlerInterface" type="Magebit\UniversalCommerce\Model\Service\Shopping\RestHandler" />
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\QuoteValidatorInterface" type="Magebit\UniversalCommerce\Model\Service\Shopping\Validation\QuoteValidationComposite" />

    <type name="Magebit\UniversalCommerce\Model\Service\Shopping\ShoppingService">
        <arguments>
            <argument name="capabilities" xsi:type="array">
                <item name="dev.ucp.shopping.checkout" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\Capability\CheckoutCapability</item>
                <item name="dev.ucp.shopping.discount" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\Capability\DiscountCapability</item>
            </argument>
        </arguments>
    </type>
    <type name="Magebit\UniversalCommerce\Model\Service\Shopping\Converter\QuoteToTotalsResponse">
        <arguments>
            <argument name="typeMapping" xsi:type="array">
                <item name="subtotal" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_SUBTOTAL</item>
                <item name="discount" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_DISCOUNT</item>
                <item name="items_discount" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_ITEMS_DISCOUNT</item>
                <item name="shipping_discount" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_DISCOUNT</item>
                <item name="fee" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_FEE</item>
                <item name="shipping" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_FULFILLMENT</item>
                <item name="tax" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_TAX</item>
                <item name="grand_total" xsi:type="const">\Magebit\UniversalCommerce\Api\Data\TotalTypeInterface::TYPE_TOTAL</item>
            </argument>
        </arguments>
    </type>
    <type name="Magebit\UniversalCommerce\Model\Service\Shopping\Validation\QuoteValidationComposite">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="quote_address_validator" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\Validation\QuoteAddressValidator</item>
                <item name="checkout_data_processor" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\CheckoutDataProcessor</item>
            </argument>
        </arguments>
    </type>

    <!-- Specification implementations -->
    <!-- Discovery -->
    <preference for="Magebit\UcpSpec\Api\Discovery\ProfileSchemaInterface" type="Magebit\UcpSpec\Data\Discovery\ProfileSchema" />

    <!-- Schemas -->
    <preference for="Magebit\UcpSpec\Api\UcpBusinessSchemaInterface" type="Magebit\UcpSpec\Data\UcpBusinessSchema" />
    <preference for="Magebit\UcpSpec\Api\CapabilityBusinessSchemaInterface" type="Magebit\UcpSpec\Data\CapabilityBusinessSchema" />
    <preference for="Magebit\UcpSpec\Api\CapabilityResponseSchemaInterface" type="Magebit\UcpSpec\Data\CapabilityResponseSchema" />
    <preference for="Magebit\UcpSpec\Api\UcpResponseCheckoutSchemaInterface" type="Magebit\UcpSpec\Data\UcpResponseCheckoutSchema" />
    <!-- Carries the agent's own webhook URL. Unbound until the profile parser gained a caller, because
         nothing had ever built one. -->
    <preference for="Magebit\UcpSpec\Api\Shopping\OrderResponsePlatformSchemaInterface" type="Magebit\UcpSpec\Data\Shopping\OrderResponsePlatformSchema" />

    <!-- Services -->
    <preference for="Magebit\UcpSpec\Api\ServiceBusinessSchemaInterface" type="Magebit\UcpSpec\Data\ServiceBusinessSchema" />

    <!-- Shopping - Checkout -->
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\CheckoutResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutResponse" />
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\CheckoutCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutCreateRequest" />
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\CheckoutUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutUpdateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\FulfillmentResponseCheckoutInterface" type="Magebit\UcpSpec\Data\Shopping\FulfillmentResponseCheckout" />
    <preference for="Magebit\UcpSpec\Api\Shopping\CheckoutCompleteRequestInterface" type="Magebit\UcpSpec\Data\Shopping\CheckoutCompleteRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentResponse" />

    <!-- Shopping - Payment -->
    <preference for="Magebit\UcpSpec\Api\Shopping\PaymentInterface" type="Magebit\UcpSpec\Data\Shopping\Payment" />

    <!-- Shopping - Types -->
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\BuyerInterface" type="Magebit\UcpSpec\Data\Shopping\Types\Buyer" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\ItemCreateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\ItemCreateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\ItemUpdateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\ItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\LineItemCreateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\LineItemCreateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\LineItemUpdateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\LineItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\PaymentInstrumentInterface" type="Magebit\UcpSpec\Data\Shopping\Types\PaymentInstrument" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\PaymentInstrumentSelectedPaymentInstrumentInterface" type="Magebit\UcpSpec\Data\Shopping\Types\PaymentInstrumentSelectedPaymentInstrument" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\ItemResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\ItemResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\LineItemResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\LineItemResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\LinkInterface" type="Magebit\UcpSpec\Data\Shopping\Types\Link" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\MessageInterface" type="Magebit\UcpSpec\Data\Shopping\Types\Message" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\MessageErrorInterface" type="Magebit\UcpSpec\Data\Shopping\Types\MessageError" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\OrderConfirmationInterface" type="Magebit\UcpSpec\Data\Shopping\Types\OrderConfirmation" />
    <preference for="Magebit\UcpSpec\Api\PaymentHandlerResponseSchemaInterface" type="Magebit\UcpSpec\Data\PaymentHandlerResponseSchema" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\TotalResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\TotalResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentMethodCreateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentMethodCreateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentDestinationRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentDestinationRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentGroupCreateRequestInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentGroupCreateRequest" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\PostalAddressInterface" type="Magebit\UcpSpec\Data\Shopping\Types\PostalAddress" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\PaymentCredentialInterface" type="Magebit\UcpSpec\Data\Shopping\Types\PaymentCredential" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentMethodResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentMethodResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentGroupResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentGroupResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentOptionResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentOptionResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentDestinationResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentDestinationResponse" />
    <preference for="Magebit\UcpSpec\Api\Shopping\Types\FulfillmentAvailableMethodResponseInterface" type="Magebit\UcpSpec\Data\Shopping\Types\FulfillmentAvailableMethodResponse" />

    <!-- Shopping - Discount -->
    <preference for="Magebit\UcpSpec\Api\Shopping\DiscountResponseDiscountsObjectInterface" type="Magebit\UcpSpec\Data\Shopping\DiscountResponseDiscountsObject" />
    <preference for="Magebit\UcpSpec\Api\Shopping\DiscountResponseAppliedDiscountInterface" type="Magebit\UcpSpec\Data\Shopping\DiscountResponseAppliedDiscount" />
    <preference for="Magebit\UcpSpec\Api\Shopping\DiscountResponseAllocationInterface" type="Magebit\UcpSpec\Data\Shopping\DiscountResponseAllocation" />
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="SeedUcpConformance" xsi:type="object">Magebit\UniversalCommerce\Console\Command\SeedConformance</item>
            </argument>
        </arguments>
    </type>
</config>
