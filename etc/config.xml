<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <universal_commerce>
            <api>
                <base_url></base_url>
                <require_request_id>1</require_request_id>
            </api>
            <idempotency>
                <ttl_hours>24</ttl_hours>
            </idempotency>
            <webhooks>
                <!-- Off until the merchant has agreed an authentication scheme with the agent platform:
                     the spec offers message signatures or a platform-allocated API key, and this module
                     sends neither yet. -->
                <enabled>0</enabled>
            </webhooks>
            <checkout>
                <payment_method>checkmo</payment_method>
            </checkout>
            <links>
                <privacy_policy></privacy_policy>
                <terms_of_service></terms_of_service>
                <refund_policy></refund_policy>
                <shipping_policy></shipping_policy>
                <faq></faq>
            </links>
        </universal_commerce>
    </default>
</config>
